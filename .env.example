# --- Core ---
DOCS_DIR=data/docs
TOP_K=4
SIMILARITY_THRESHOLD=0.20
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SNIPPET_CHARS=260

# --- Embeddings ---
# assessment mode: openai
# local/offline demo: tfidf
# alternative: sentence_transformer
EMBEDDING_PROVIDER=tfidf
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Answer generation ---
# assessment mode: openai (or anthropic)
# local/offline demo: extractive
LLM_PROVIDER=extractive
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_CHAT_MODEL=claude-sonnet-5

# Required only when the matching provider is selected above.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
